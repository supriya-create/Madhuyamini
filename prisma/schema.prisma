// Madhuyamini data model. Rules and rationale: docs/data-model.md.
// Database-level CHECK constraints live in the SQL migrations.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN

  @@map("user_role")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

/// Decorative techniques applied to a piece. A product lists every technique
/// used (at least one), so a print is never presented as a painting.
enum Technique {
  HAND_PAINTED
  HAND_BLOCK_PRINTED
  SCREEN_PRINTED
  DIGITAL_PRINT
  EMBROIDERED
  APPLIQUE

  @@map("technique")
}

/// How the object itself is made, independent of its decoration.
enum ConstructionMethod {
  HANDWOVEN
  MILL_WOVEN
  HAND_STITCHED
  MACHINE_STITCHED
  HANDMADE_PAPER
  STRETCHED_CANVAS
  FRAMED

  @@map("construction_method")
}

/// Lifecycle of a stock hold. Only ACTIVE holds count towards Inventory.reserved.
enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED

  @@map("reservation_status")
}

enum CartStatus {
  ACTIVE
  MERGED
  CONVERTED
  ABANDONED

  @@map("cart_status")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("review_status")
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

/// Customers and staff. Better Auth owns sign-in; this app owns `role`,
/// `phone` and everything below. Password hashes live in Account.password.
model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  /// Stored lower-cased and trimmed; lookups normalise the same way.
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  name          String
  image         String?
  /// E.164, e.g. +919876543210. Optional at registration (P2).
  phone         String?
  /// Never accepted from client input; changed only by admin tooling (Phase 7).
  role          UserRole @default(CUSTOMER)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  addresses          Address[]
  reviews            Review[]
  sessions           Session[]
  accounts           Account[]
  carts              Cart[]
  wishlistItems      WishlistItem[]
  orders             Order[]
  auditEntries       AdminAuditLog[]
  staffTwoFactor     StaffTwoFactor?
  staffRecoveryCodes StaffRecoveryCode[]
  staffVerifications StaffSessionVerification[]
  piiGrantsReceived  StaffPiiGrant[]            @relation("PiiGrantee")
  piiGrantsGiven     StaffPiiGrant[]            @relation("PiiGrantor")
  piiRevealsMade     StaffPiiReveal[]           @relation("PiiRevealStaff")
  piiRevealsAbout    StaffPiiReveal[]           @relation("PiiRevealCustomer")

  @@map("users")
}

/// Better Auth session. The cookie carries `token`; sessions are revocable
/// individually or all at once. No IP addresses are recorded (privacy).
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffVerification StaffSessionVerification?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Better Auth account: one sign-in method per row. Email/password uses
/// providerId "credential" and stores the password hash here.
model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  providerId            String    @map("provider_id")
  accountId             String    @map("account_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Better Auth verification records (email verification, password reset).
/// `value` holds a hashed or random token; rows are single-use and expire.
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

/// Fixed-window counters (D5). Shared by Better Auth's HTTP rate limiter and
/// the application's own limits on sign-in, registration, reset and
/// verification. `lastRequest` is the window start in epoch milliseconds.
model RateLimit {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@index([lastRequest])
  @@map("rate_limits")
}

/// Address book. Orders copy the address at purchase time (Phase 6), so edits
/// here never change order history.
model Address {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  label         String?
  recipientName String   @map("recipient_name")
  phone         String
  line1         String
  line2         String?
  landmark      String?
  city          String
  state         String
  postalCode    String   @map("postal_code")
  country       String   @default("IN")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId], map: "addresses_one_default_per_user", where: { isDefault: true })
  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  parentId    String?  @map("parent_id") @db.Uuid
  position    Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId, position])
  @@map("categories")
}

model Product {
  id                  String               @id @default(uuid(7)) @db.Uuid
  slug                String               @unique
  title               String
  subtitle            String?
  description         String
  /// Ordered; the first entry is the headline technique. Never empty (CHECK).
  techniques          Technique[]          @default([])
  constructionMethods ConstructionMethod[] @default([]) @map("construction_methods")
  material            String?
  careInstructions    String?              @map("care_instructions")
  categoryId          String               @map("category_id") @db.Uuid
  status              ProductStatus        @default(DRAFT)
  publishedAt         DateTime?            @map("published_at")
  isFeatured          Boolean              @default(false) @map("is_featured")
  /// A single original: its one variant carries stock 1.
  isOneOfAKind        Boolean              @default(false) @map("is_one_of_a_kind")
  hsnCode             String?              @map("hsn_code")
  /// GST rate in basis points (500 = 5 %). Applied in Phase 6 once confirmed.
  taxRateBp           Int?                 @map("tax_rate_bp")
  metaTitle           String?              @map("meta_title")
  metaDescription     String?              @map("meta_description")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  category      Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  options       ProductOption[]
  variants      ProductVariant[]
  reviews       Review[]
  wishlistItems WishlistItem[]

  @@index([categoryId, status])
  @@index([status, isFeatured])
  @@index([status, publishedAt])
  @@index([techniques], type: Gin)
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  variantId String?  @map("variant_id") @db.Uuid
  url       String
  publicId  String?  @map("public_id")
  /// Required: every image must describe the piece.
  alt       String
  width     Int
  height    Int
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, position])
  @@map("product_images")
}

/// A variant axis such as "Size" or "Frame".
model ProductOption {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  name      String
  position  Int    @default(0)

  product       Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  values        ProductOptionValue[]
  variantValues ProductVariantValue[]

  @@unique([productId, name])
  @@map("product_options")
}

model ProductOptionValue {
  id       String @id @default(uuid(7)) @db.Uuid
  optionId String @map("option_id") @db.Uuid
  value    String
  position Int    @default(0)

  option        ProductOption         @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variantValues ProductVariantValue[]

  @@unique([optionId, value])
  @@map("product_option_values")
}

/// The purchasable unit. All prices live here, as integer paise.
model ProductVariant {
  id                    String   @id @default(uuid(7)) @db.Uuid
  productId             String   @map("product_id") @db.Uuid
  sku                   String   @unique
  /// Derived label such as "M / Indigo"; null for single-variant products.
  title                 String?
  priceInPaise          Int      @map("price_in_paise")
  compareAtPriceInPaise Int?     @map("compare_at_price_in_paise")
  weightGrams           Int?     @map("weight_grams")
  position              Int      @default(0)
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  product      Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory    Inventory?
  optionValues ProductVariantValue[]
  images       ProductImage[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  adjustments  InventoryAdjustment[]

  @@index([productId, position])
  @@map("product_variants")
}

/// Links a variant to exactly one value per option.
model ProductVariantValue {
  variantId     String @map("variant_id") @db.Uuid
  optionId      String @map("option_id") @db.Uuid
  optionValueId String @map("option_value_id") @db.Uuid

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  option      ProductOption      @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Restrict)

  @@id([variantId, optionValueId])
  @@unique([variantId, optionId])
  @@map("product_variant_values")
}

model Inventory {
  variantId         String   @id @map("variant_id") @db.Uuid
  stockOnHand       Int      @default(0) @map("stock_on_hand")
  /// Held for pending online payments (Phase 6). Available = stockOnHand - reserved.
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(2) @map("low_stock_threshold")
  updatedAt         DateTime @updatedAt @map("updated_at")

  variant      ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  reservations InventoryReservation[]

  @@map("inventory")
}

/// A time-limited hold on stock while an online payment is pending (Phase 6).
/// Invariant: Inventory.reserved equals the sum of ACTIVE holds for that
/// variant; holds are created, consumed and released inside one transaction
/// with the counter. A scheduled sweep expires holds past `expiresAt`.
/// Phase 6 adds the owning order reference.
model InventoryReservation {
  id        String            @id @default(uuid(7)) @db.Uuid
  variantId String            @map("variant_id") @db.Uuid
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime          @map("expires_at")
  /// When the hold left ACTIVE (released, consumed or expired).
  closedAt  DateTime?         @map("closed_at")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  /// The order holding this stock (Phase 6). Nullable so holds from other flows stay valid.
  orderId   String?           @map("order_id") @db.Uuid

  inventory Inventory @relation(fields: [variantId], references: [variantId], onDelete: Restrict)
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, variantId])
  @@index([status, expiresAt])
  @@index([variantId, status])
  @@map("inventory_reservations")
}

// ---------------------------------------------------------------------------
// Cart and wishlist (Phase 5). Lines hold variant + quantity only; prices are
// always read live and locked only when an order is created (Phase 6).
// ---------------------------------------------------------------------------

/// One ACTIVE cart per signed-in customer (partial unique index) or per guest
/// token. Guest carts expire 30 days after their last activity (C2).
model Cart {
  id             String     @id @default(uuid(7)) @db.Uuid
  userId         String?    @map("user_id") @db.Uuid
  /// SHA-256 of the guest cookie token; never the token itself.
  tokenHash      String?    @unique @map("token_hash")
  status         CartStatus @default(ACTIVE)
  lastActivityAt DateTime   @default(now()) @map("last_activity_at")
  expiresAt      DateTime?  @map("expires_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  user   User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]
  orders Order[]

  @@unique([userId], map: "carts_one_active_per_user", where: { status: "ACTIVE" })
  @@index([status, expiresAt])
  @@map("carts")
}

model CartItem {
  id               String   @id @default(uuid(7)) @db.Uuid
  cartId           String   @map("cart_id") @db.Uuid
  variantId        String   @map("variant_id") @db.Uuid
  /// 1–10 (CHECK). Clamped on the server against availability (C1).
  quantity         Int
  /// Price the customer saw when the line was added; differs from the live
  /// price when it has changed since (C5). Updated when acknowledged.
  priceSeenInPaise Int      @map("price_seen_in_paise")
  addedAt          DateTime @default(now()) @map("added_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

/// Product-level saves for signed-in customers only (C3).
model WishlistItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id                 String       @id @default(uuid(7)) @db.Uuid
  productId          String       @map("product_id") @db.Uuid
  userId             String       @map("user_id") @db.Uuid
  rating             Int
  title              String?
  body               String
  status             ReviewStatus @default(PENDING)
  /// Set from order history in Phase 8; nothing is displayed before then.
  isVerifiedPurchase Boolean      @default(false) @map("is_verified_purchase")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, status])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Orders and payments (Phase 6). Design: docs/checkout.md.
// ---------------------------------------------------------------------------

/// Phase 7/8 append fulfilment states (PROCESSING, SHIPPED, DELIVERED, RETURNED).
enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  NEEDS_REVIEW
  PROCESSING
  SHIPPED
  DELIVERED
  /// Parcel refused, unclaimed, undeliverable or lost: return to origin (docs/admin.md §5.11).
  DELIVERY_FAILED
  /// Parcel physically back; awaiting inspection before any stock returns.
  RETURNED

  @@map("order_status")
}

enum CancellationReason {
  PAYMENT_FAILED
  PAYMENT_TIMEOUT
  CUSTOMER
  STOCK_UNAVAILABLE
  ADMIN
  COD_REFUSED
  DELIVERY_FAILED

  @@map("cancellation_reason")
}

enum PaymentMethod {
  RAZORPAY
  COD

  @@map("payment_method")
}

/// INITIATED: our intent row exists and no provider order yet; CREATED: the
/// provider order id is persisted. Transitions: src/features/orders/transitions.ts.
enum PaymentStatus {
  INITIATED
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED

  @@map("payment_status")
}

enum RefundStatus {
  INITIATED
  REQUESTED
  PROCESSED
  FAILED

  @@map("refund_status")
}

enum OrderActor {
  CUSTOMER
  SYSTEM
  WEBHOOK
  CRON
  ADMIN
  STAFF

  @@map("order_actor")
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED

  @@map("webhook_status")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED

  @@map("notification_status")
}

/// A purchase. Amounts are integer paise computed on the server; the address
/// is copied at placement so later edits never change history.
model Order {
  id                 String              @id @default(uuid(7)) @db.Uuid
  orderNumber        String              @unique @map("order_number")
  /// Null for guests; guest access goes through OrderAccessToken.
  userId             String?             @map("user_id") @db.Uuid
  /// Lower-cased.
  email              String
  /// E.164.
  phone              String
  status             OrderStatus         @default(PENDING_PAYMENT)
  paymentMethod      PaymentMethod       @map("payment_method")
  currency           String              @default("INR")
  subtotalInPaise    Int                 @map("subtotal_in_paise")
  shippingInPaise    Int                 @map("shipping_in_paise")
  codFeeInPaise      Int                 @default(0) @map("cod_fee_in_paise")
  discountInPaise    Int                 @default(0) @map("discount_in_paise")
  totalInPaise       Int                 @map("total_in_paise")
  /// Tax included in the total, informational; null while no product carries a rate.
  taxInPaise         Int?                @map("tax_in_paise")
  recipientName      String              @map("recipient_name")
  addressLine1       String              @map("address_line1")
  addressLine2       String?             @map("address_line2")
  landmark           String?
  city               String
  state              String
  postalCode         String              @map("postal_code")
  country            String              @default("IN")
  customerNote       String?             @map("customer_note")
  cartId             String?             @map("cart_id") @db.Uuid
  /// Online orders: the reservation deadline. Null for COD.
  pendingExpiresAt   DateTime?           @map("pending_expires_at")
  /// How many times the deadline was extended by a new attempt (policy.reservation.maxExtensions).
  deadlineExtensions Int                 @default(0) @map("deadline_extensions")
  confirmedAt        DateTime?           @map("confirmed_at")
  cancelledAt        DateTime?           @map("cancelled_at")
  cancellationReason CancellationReason? @map("cancellation_reason")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  user          User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  cart          Cart?                  @relation(fields: [cartId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payments      Payment[]
  refunds       Refund[]
  accessTokens  OrderAccessToken[]
  reservations  InventoryReservation[]
  events        OrderEvent[]
  notifications NotificationOutbox[]
  shipment      Shipment?

  /// Placement idempotency: one live order per cart (docs/checkout.md §5.7).
  @@unique([cartId], map: "orders_one_live_per_cart", where: raw("status <> 'CANCELLED'::order_status"))
  @@index([userId, createdAt])
  @@index([status, pendingExpiresAt])
  @@index([email])
  @@map("orders")
}

/// Immutable snapshot of what was bought, at the price it was bought.
model OrderItem {
  id               String  @id @default(uuid(7)) @db.Uuid
  orderId          String  @map("order_id") @db.Uuid
  variantId        String  @map("variant_id") @db.Uuid
  productSlug      String  @map("product_slug")
  productTitle     String  @map("product_title")
  variantTitle     String? @map("variant_title")
  sku              String
  quantity         Int
  unitPriceInPaise Int     @map("unit_price_in_paise")
  lineTotalInPaise Int     @map("line_total_in_paise")
  taxRateBp        Int?    @map("tax_rate_bp")
  hsnCode          String? @map("hsn_code")
  imageUrl         String? @map("image_url")
  imageAlt         String? @map("image_alt")

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Sold variants are archived, never deleted.
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([orderId, variantId])
  @@map("order_items")
}

/// One row per payment attempt, written before the provider is called and
/// carrying the `receipt` the provider stores, so a lost response is recoverable.
model Payment {
  id                  String        @id @default(uuid(7)) @db.Uuid
  orderId             String        @map("order_id") @db.Uuid
  attemptNo           Int           @map("attempt_no")
  method              PaymentMethod
  status              PaymentStatus @default(INITIATED)
  amountInPaise       Int           @map("amount_in_paise")
  currency            String        @default("INR")
  /// `${orderNumber}-${attemptNo}`; unique at Razorpay as well (≤ 40 ASCII chars).
  receipt             String        @unique
  providerOrderId     String?       @unique @map("provider_order_id")
  providerPaymentId   String?       @unique @map("provider_payment_id")
  signatureVerifiedAt DateTime?     @map("signature_verified_at")
  providerAttempts    Int           @default(0) @map("provider_attempts")
  lastError           String?       @map("last_error")
  authorizedAt        DateTime?     @map("authorized_at")
  capturedAt          DateTime?     @map("captured_at")
  failedAt            DateTime?     @map("failed_at")
  failureCode         String?       @map("failure_code")
  failureDescription  String?       @map("failure_description")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@unique([orderId, attemptNo])
  /// One open attempt at a time (docs/checkout.md §5.7).
  @@unique([orderId], map: "payments_one_open_per_order", where: raw("status = ANY (ARRAY['INITIATED'::payment_status, 'CREATED'::payment_status, 'AUTHORIZED'::payment_status])"))
  @@index([orderId, createdAt])
  @@map("payments")
}

/// Refund intent and outcome. Written in the transaction that decided it; the
/// provider call happens later from the refund-payments job.
model Refund {
  id               String       @id @default(uuid(7)) @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  status           RefundStatus @default(INITIATED)
  amountInPaise    Int          @map("amount_in_paise")
  reason           String
  /// Sent to the provider as `receipt` and in notes, so an unanswered request can be found again.
  reference        String       @unique
  providerRefundId String?      @unique @map("provider_refund_id")
  /// The admin operation that created it (docs/admin.md §5.5): one refund per submitted form, unique. Null for automatic refunds.
  operationKey     String?      @unique @map("operation_key") @db.Uuid
  attempts         Int          @default(0)
  nextAttemptAt    DateTime     @default(now()) @map("next_attempt_at")
  claimedAt        DateTime?    @map("claimed_at")
  claimedBy        String?      @map("claimed_by")
  lastError        String?      @map("last_error")
  requestedAt      DateTime?    @map("requested_at")
  processedAt      DateTime?    @map("processed_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("refunds")
}

/// Guest access to one order: SHA-256 of a random 256-bit cookie token.
model OrderAccessToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  orderId    String    @map("order_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([expiresAt])
  @@map("order_access_tokens")
}

/// Every webhook delivery, keyed by the provider's event id: the idempotency
/// ledger and the retry queue for applying it.
model PaymentWebhookEvent {
  id                String        @id
  eventType         String        @map("event_type")
  status            WebhookStatus @default(RECEIVED)
  providerOrderId   String?       @map("provider_order_id")
  providerPaymentId String?       @map("provider_payment_id")
  orderId           String?       @map("order_id") @db.Uuid
  payload           Json
  attempts          Int           @default(0)
  nextAttemptAt     DateTime      @default(now()) @map("next_attempt_at")
  claimedAt         DateTime?     @map("claimed_at")
  claimedBy         String?       @map("claimed_by")
  lastError         String?       @map("last_error")
  receivedAt        DateTime      @default(now()) @map("received_at")
  processedAt       DateTime?     @map("processed_at")

  @@index([status, nextAttemptAt])
  @@index([providerPaymentId])
  @@map("payment_webhook_events")
}

/// Append-only timeline. Application code never updates or deletes rows.
model OrderEvent {
  id         String       @id @default(uuid(7)) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  type       String
  actor      OrderActor
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus? @map("to_status")
  note       String?
  data       Json?
  createdAt  DateTime     @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

/// Durable email queue, written in the same transaction as the state it announces.
model NotificationOutbox {
  id            String             @id @default(uuid(7)) @db.Uuid
  kind          String
  /// `${kind}:${orderId}`: one email per fact, and the provider idempotency key.
  dedupeKey     String             @unique @map("dedupe_key")
  orderId       String?            @map("order_id") @db.Uuid
  recipient     String
  /// Everything the template needs, captured at enqueue time.
  payload       Json
  status        NotificationStatus @default(PENDING)
  attempts      Int                @default(0)
  nextAttemptAt DateTime           @default(now()) @map("next_attempt_at")
  claimedAt     DateTime?          @map("claimed_at")
  claimedBy     String?            @map("claimed_by")
  lastError     String?            @map("last_error")
  sentAt        DateTime?          @map("sent_at")
  createdAt     DateTime           @default(now()) @map("created_at")

  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("notification_outbox")
}

// ---------------------------------------------------------------------------
// Admin and store operations (Phase 7). Design: docs/admin.md.
// ---------------------------------------------------------------------------

enum AuditOutcome {
  SUCCESS
  REFUSED
  FAILED

  @@map("audit_outcome")
}

enum InventoryAdjustmentKind {
  RECEIVED
  CORRECTION
  WRITE_OFF
  /// System restock when an unshipped order is cancelled.
  RESTOCK_ON_CANCEL
  /// Inspection of a physically returned parcel (always with an actor).
  RESTOCK_ON_RETURN

  @@map("inventory_adjustment_kind")
}

enum UploadStatus {
  ISSUED
  ATTACHED
  DISCARDED
  SWEPT

  @@map("upload_status")
}

/// Append-only: an immutability trigger and no UPDATE/DELETE privilege for
/// the runtime role. SUCCESS rows share the mutation's transaction; REFUSED
/// and FAILED rows are written after the business transaction rolled back.
model AdminAuditLog {
  id         String       @id @default(uuid(7)) @db.Uuid
  /// Null only for scripts and system sweeps (see actorLabel; CHECK).
  actorId    String?      @map("actor_id") @db.Uuid
  /// "user:<id>", "script:promote-admin@<host>", "system:upload-sweep".
  actorLabel String       @map("actor_label")
  actorRole  UserRole?    @map("actor_role")
  sessionId  String?      @map("session_id") @db.Uuid
  action     String
  targetType String       @map("target_type")
  targetId   String?      @map("target_id")
  outcome    AuditOutcome
  reason     String?
  /// FAILED: the AppError code, never a message or stack.
  errorCode  String?      @map("error_code")
  /// The staff_pii_grants row a reveal relied on.
  grantId    String?      @map("grant_id") @db.Uuid
  /// Redacted snapshots (allow-list per target type).
  before     Json?
  after      Json?
  /// SHA-256 of the client address, as the rate limiter stores it.
  requestIp  String?      @map("request_ip")
  createdAt  DateTime     @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("admin_audit_log")
}

/// Every admin-originated stock change with who, why and the quantities
/// before and after. Sales remain derivable from order_items.
model InventoryAdjustment {
  id             String                  @id @default(uuid(7)) @db.Uuid
  variantId      String                  @map("variant_id") @db.Uuid
  kind           InventoryAdjustmentKind
  /// Signed; CHECK <> 0.
  delta          Int
  stockBefore    Int                     @map("stock_before")
  /// CHECK = stock_before + delta AND >= reserved_at_time.
  stockAfter     Int                     @map("stock_after")
  reservedAtTime Int                     @map("reserved_at_time")
  /// CHECK length >= 3.
  reason         String
  /// Required unless kind = RESTOCK_ON_CANCEL (CHECK).
  actorId        String?                 @map("actor_id") @db.Uuid
  /// Required for RESTOCK_ON_CANCEL and RESTOCK_ON_RETURN (CHECK).
  orderId        String?                 @map("order_id") @db.Uuid
  auditId        String?                 @map("audit_id") @db.Uuid
  createdAt      DateTime                @default(now()) @map("created_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt])
  @@index([orderId])
  @@map("inventory_adjustments")
}

/// One shipment per order in Phase 7, including the return-to-origin facts.
model Shipment {
  id                    String    @id @default(uuid(7)) @db.Uuid
  orderId               String    @unique @map("order_id") @db.Uuid
  carrier               String
  trackingNumber        String?   @map("tracking_number")
  /// CHECK: https:// only.
  trackingUrl           String?   @map("tracking_url")
  shippedAt             DateTime  @map("shipped_at")
  /// CHECK >= shipped_at.
  deliveredAt           DateTime? @map("delivered_at")
  deliveryFailedAt      DateTime? @map("delivery_failed_at")
  /// COD_REFUSED | ADDRESS_NOT_FOUND | UNCLAIMED | CARRIER_LOST | OTHER
  deliveryFailureReason String?   @map("delivery_failure_reason")
  /// CHECK >= delivery_failed_at.
  returnedAt            DateTime? @map("returned_at")
  /// CHECK >= returned_at.
  inspectedAt           DateTime? @map("inspected_at")
  inspectionNote        String?   @map("inspection_note")
  carrierClaimReference String?   @map("carrier_claim_reference")
  createdById           String    @map("created_by_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shipments")
}

/// Staff second factor (own RFC 6238 implementation, docs/admin.md §5.9).
model StaffTwoFactor {
  userId           String    @id @map("user_id") @db.Uuid
  /// AES-256-GCM ciphertext of the TOTP secret under ADMIN_TOTP_KEY.
  secretCiphertext String    @map("secret_ciphertext")
  keyVersion       Int       @map("key_version")
  /// Null until the first code verifies: an unverified enrolment never counts.
  enabledAt        DateTime? @map("enabled_at")
  /// Replay protection: advanced only by an atomic conditional update.
  lastAcceptedStep BigInt?   @map("last_accepted_step")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_two_factor")
}

/// One-time recovery codes, stored hashed, consumed by a conditional update.
model StaffRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("staff_recovery_codes")
}

/// Proof that THIS session passed the second factor. No row, no admin access.
model StaffSessionVerification {
  sessionId  String   @id @map("session_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// TOTP | RECOVERY
  method     String
  /// Refreshed by re-authentication.
  verifiedAt DateTime @map("verified_at")
  createdAt  DateTime @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("staff_session_verifications")
}

/// Scoped, time-limited permission for one staff member to reveal contact
/// details; re-read on every render, so revocation is immediate.
model StaffPiiGrant {
  id          String    @id @default(uuid(7)) @db.Uuid
  granteeId   String    @map("grantee_id") @db.Uuid
  grantedById String    @map("granted_by_id") @db.Uuid
  /// Null = any customer during a support shift.
  customerId  String?   @map("customer_id") @db.Uuid
  /// Subset of email, phone, address (CHECK).
  fields      String[]
  reason      String
  /// CHECK <= created_at + 24 hours.
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  revokedById String?   @map("revoked_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  grantee   User @relation("PiiGrantee", fields: [granteeId], references: [id], onDelete: Cascade)
  grantedBy User @relation("PiiGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@index([granteeId, expiresAt])
  @@map("staff_pii_grants")
}

/// One reveal: which grant, which customer, which fields, until when.
model StaffPiiReveal {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// Null when the actor is ADMIN (inherent permission).
  grantId    String?  @map("grant_id") @db.Uuid
  staffId    String   @map("staff_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  fields     String[]
  reason     String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  staff    User @relation("PiiRevealStaff", fields: [staffId], references: [id], onDelete: Cascade)
  customer User @relation("PiiRevealCustomer", fields: [customerId], references: [id], onDelete: Cascade)

  @@index([staffId, expiresAt])
  @@index([customerId, createdAt])
  @@map("staff_pii_reveals")
}

/// Every upload signature the server issued, so the orphan sweep deletes
/// only assets we created, inside our folder, after the grace period.
model ProductImageUpload {
  id         String       @id @default(uuid(7)) @db.Uuid
  productId  String       @map("product_id") @db.Uuid
  /// CHECK LIKE 'madhuyamini/products/%'.
  publicId   String       @unique @map("public_id")
  /// CHECK = 'madhuyamini/products/' || product_id.
  folder     String
  issuedById String       @map("issued_by_id") @db.Uuid
  status     UploadStatus @default(ISSUED)
  issuedAt   DateTime     @default(now()) @map("issued_at")
  resolvedAt DateTime?    @map("resolved_at")
  sweepError String?      @map("sweep_error")

  @@index([status, issuedAt])
  @@map("product_image_uploads")
}
