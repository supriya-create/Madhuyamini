// Madhuyamini data model. Rules and rationale: docs/data-model.md.
// Database-level CHECK constraints live in the SQL migrations.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN

  @@map("user_role")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

/// Decorative techniques applied to a piece. A product lists every technique
/// used (at least one), so a print is never presented as a painting.
enum Technique {
  HAND_PAINTED
  HAND_BLOCK_PRINTED
  SCREEN_PRINTED
  DIGITAL_PRINT
  EMBROIDERED
  APPLIQUE

  @@map("technique")
}

/// How the object itself is made, independent of its decoration.
enum ConstructionMethod {
  HANDWOVEN
  MILL_WOVEN
  HAND_STITCHED
  MACHINE_STITCHED
  HANDMADE_PAPER
  STRETCHED_CANVAS
  FRAMED

  @@map("construction_method")
}

/// Lifecycle of a stock hold. Only ACTIVE holds count towards Inventory.reserved.
enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED

  @@map("reservation_status")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("review_status")
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// Stored lower-cased and trimmed; lookups normalise the same way.
  email           String    @unique
  emailVerifiedAt DateTime? @map("email_verified_at")
  /// Argon2id hash (Phase 4). Null allows passwordless or social sign-in.
  passwordHash    String?   @map("password_hash")
  name            String
  /// E.164, e.g. +919876543210
  phone           String?
  role            UserRole  @default(CUSTOMER)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  addresses Address[]
  reviews   Review[]

  @@map("users")
}

/// Address book. Orders copy the address at purchase time (Phase 6), so edits
/// here never change order history.
model Address {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  label         String?
  recipientName String   @map("recipient_name")
  phone         String
  line1         String
  line2         String?
  landmark      String?
  city          String
  state         String
  postalCode    String   @map("postal_code")
  country       String   @default("IN")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId], map: "addresses_one_default_per_user", where: { isDefault: true })
  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  parentId    String?  @map("parent_id") @db.Uuid
  position    Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId, position])
  @@map("categories")
}

model Product {
  id                  String               @id @default(uuid(7)) @db.Uuid
  slug                String               @unique
  title               String
  subtitle            String?
  description         String
  /// Ordered; the first entry is the headline technique. Never empty (CHECK).
  techniques          Technique[]          @default([])
  constructionMethods ConstructionMethod[] @default([]) @map("construction_methods")
  material            String?
  careInstructions    String?              @map("care_instructions")
  categoryId          String               @map("category_id") @db.Uuid
  status              ProductStatus        @default(DRAFT)
  publishedAt         DateTime?            @map("published_at")
  isFeatured          Boolean              @default(false) @map("is_featured")
  /// A single original: its one variant carries stock 1.
  isOneOfAKind        Boolean              @default(false) @map("is_one_of_a_kind")
  hsnCode             String?              @map("hsn_code")
  /// GST rate in basis points (500 = 5 %). Applied in Phase 6 once confirmed.
  taxRateBp           Int?                 @map("tax_rate_bp")
  metaTitle           String?              @map("meta_title")
  metaDescription     String?              @map("meta_description")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images   ProductImage[]
  options  ProductOption[]
  variants ProductVariant[]
  reviews  Review[]

  @@index([categoryId, status])
  @@index([status, isFeatured])
  @@index([status, publishedAt])
  @@index([techniques], type: Gin)
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  variantId String?  @map("variant_id") @db.Uuid
  url       String
  publicId  String?  @map("public_id")
  /// Required: every image must describe the piece.
  alt       String
  width     Int
  height    Int
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, position])
  @@map("product_images")
}

/// A variant axis such as "Size" or "Frame".
model ProductOption {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  name      String
  position  Int    @default(0)

  product       Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  values        ProductOptionValue[]
  variantValues ProductVariantValue[]

  @@unique([productId, name])
  @@map("product_options")
}

model ProductOptionValue {
  id       String @id @default(uuid(7)) @db.Uuid
  optionId String @map("option_id") @db.Uuid
  value    String
  position Int    @default(0)

  option        ProductOption         @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variantValues ProductVariantValue[]

  @@unique([optionId, value])
  @@map("product_option_values")
}

/// The purchasable unit. All prices live here, as integer paise.
model ProductVariant {
  id                    String   @id @default(uuid(7)) @db.Uuid
  productId             String   @map("product_id") @db.Uuid
  sku                   String   @unique
  /// Derived label such as "M / Indigo"; null for single-variant products.
  title                 String?
  priceInPaise          Int      @map("price_in_paise")
  compareAtPriceInPaise Int?     @map("compare_at_price_in_paise")
  weightGrams           Int?     @map("weight_grams")
  position              Int      @default(0)
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  product      Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory    Inventory?
  optionValues ProductVariantValue[]
  images       ProductImage[]

  @@index([productId, position])
  @@map("product_variants")
}

/// Links a variant to exactly one value per option.
model ProductVariantValue {
  variantId     String @map("variant_id") @db.Uuid
  optionId      String @map("option_id") @db.Uuid
  optionValueId String @map("option_value_id") @db.Uuid

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  option      ProductOption      @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Restrict)

  @@id([variantId, optionValueId])
  @@unique([variantId, optionId])
  @@map("product_variant_values")
}

model Inventory {
  variantId         String   @id @map("variant_id") @db.Uuid
  stockOnHand       Int      @default(0) @map("stock_on_hand")
  /// Held for pending online payments (Phase 6). Available = stockOnHand - reserved.
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(2) @map("low_stock_threshold")
  updatedAt         DateTime @updatedAt @map("updated_at")

  variant      ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  reservations InventoryReservation[]

  @@map("inventory")
}

/// A time-limited hold on stock while an online payment is pending (Phase 6).
/// Invariant: Inventory.reserved equals the sum of ACTIVE holds for that
/// variant; holds are created, consumed and released inside one transaction
/// with the counter. A scheduled sweep expires holds past `expiresAt`.
/// Phase 6 adds the owning order reference.
model InventoryReservation {
  id        String            @id @default(uuid(7)) @db.Uuid
  variantId String            @map("variant_id") @db.Uuid
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime          @map("expires_at")
  /// When the hold left ACTIVE (released, consumed or expired).
  closedAt  DateTime?         @map("closed_at")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  inventory Inventory @relation(fields: [variantId], references: [variantId], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([variantId, status])
  @@map("inventory_reservations")
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id                 String       @id @default(uuid(7)) @db.Uuid
  productId          String       @map("product_id") @db.Uuid
  userId             String       @map("user_id") @db.Uuid
  rating             Int
  title              String?
  body               String
  status             ReviewStatus @default(PENDING)
  /// Set from order history in Phase 8; nothing is displayed before then.
  isVerifiedPurchase Boolean      @default(false) @map("is_verified_purchase")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, status])
  @@map("reviews")
}
