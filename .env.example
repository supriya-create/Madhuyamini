# Copy to .env.local for local development. Never commit real values.

# Deployment stage: development | preview | production.
# Falls back to VERCEL_ENV on Vercel. Controls search-engine indexing,
# development-only pages and image placeholders.
SITE_ENV=development

# Canonical origin, no trailing slash. Required (https) when SITE_ENV=production.
SITE_URL=http://localhost:3000

# PostgreSQL connection for the application and the Prisma CLI. Server-only.
# Use the pooled URL from your host in production; never commit real values.
# A preview deployment (SITE_ENV/VERCEL_ENV=preview) must use a separate
# database whose name ends in _preview or _test; it refuses to start otherwise
# (docs/environments.md). The suffix is a safeguard, not proof of isolation.
DATABASE_URL=postgresql://user:password@localhost:5432/madhuyamini

# Separate database used by `npm run test:integration` (it is wiped between tests).
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/madhuyamini_test

# Better Auth signing secret: at least 32 random characters. Generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Outbound email. file = write JSON to .mail/ (development and tests),
# log = print to the server log, resend = Resend (required in production).
EMAIL_TRANSPORT=file
EMAIL_FROM="Madhuyamini <hello@example.com>"
RESEND_API_KEY=

# Compromised-password check against Have I Been Pwned (k-anonymity, fails
# open). hibp (default in production) or off (default elsewhere).
PASSWORD_BREACH_CHECK=off

# Payments (Phase 6; rules in docs/environments.md). razorpay = the real
# gateway, fake = the in-process gateway for development, tests and CI.
# Defaults: fake when SITE_ENV=development, razorpay everywhere else. A preview
# that wants the fake gateway must set it explicitly; production refuses it.
PAYMENT_GATEWAY=fake
# Razorpay API keys (Dashboard → Account & Settings → API Keys). The key id's
# prefix is validated: rzp_test_ is required outside production and rzp_live_
# in production. The id, the secret and RAZORPAY_WEBHOOK_SECRET are one unit:
# set all three or none (keys without the webhook secret are refused in every
# stage, because deliveries could not be verified). A build never needs them;
# a production server refuses to start without them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret configured in the Razorpay Dashboard; required whenever the
# keys are set. Locally, where Razorpay cannot reach you, any non-empty value
# will do. During rotation keep the old one in RAZORPAY_WEBHOOK_SECRET_PREVIOUS
# until deliveries with it stop.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=

# Bearer secret for the scheduled job routes (/api/cron/*), at least 16 characters.
# Vercel Cron sends it automatically when the variable is named CRON_SECRET.
CRON_SECRET=

# Inbox for new-order notices and operations alerts (optional).
ORDER_NOTIFY_EMAIL=

# Admin area (Phase 7). Encrypts staff TOTP secrets; 32 random bytes as
# base64url. Generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Without it no staff member can sign in to /admin. Rotate by moving the old
# value to ADMIN_TOTP_KEY_PREVIOUS.
ADMIN_TOTP_KEY=
ADMIN_TOTP_KEY_PREVIOUS=
# Development only: when set, `npm run db:seed` creates admin@example.com (ADMIN) and
# staff@example.com (STAFF) with this password. They enrol their second factor on first
# sign-in. The seed refuses production and remote databases.
SEED_ADMIN_PASSWORD=

# Cloudinary (product image uploads from the admin). All three or none.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# A *signed* upload preset in the Cloudinary console that enforces the byte ceiling
# and dimension limits at Cloudinary itself; bound into every upload signature.
# Optional in development; required in production whenever Cloudinary is configured.
CLOUDINARY_UPLOAD_PRESET=

# Migrations and the promote script connect as the table owner; the running
# application should use the restricted runtime role (scripts/provision-db-roles.sql).
# Leave unset locally to use DATABASE_URL for both.
MIGRATION_DATABASE_URL=
