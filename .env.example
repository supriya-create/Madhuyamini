# Copy to .env.local for local development. Never commit real values.

# Deployment stage: development | preview | production.
# Falls back to VERCEL_ENV on Vercel. Controls search-engine indexing,
# development-only pages and image placeholders.
SITE_ENV=development

# Canonical origin, no trailing slash. Required (https) when SITE_ENV=production.
SITE_URL=http://localhost:3000

# PostgreSQL connection for the application and the Prisma CLI. Server-only.
# Use the pooled URL from your host in production; never commit real values.
DATABASE_URL=postgresql://user:password@localhost:5432/madhuyamini

# Separate database used by `npm run test:integration` (it is wiped between tests).
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/madhuyamini_test

# Better Auth signing secret: at least 32 random characters. Generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Outbound email. file = write JSON to .mail/ (development and tests),
# log = print to the server log, resend = Resend (required in production).
EMAIL_TRANSPORT=file
EMAIL_FROM="Madhuyamini <hello@example.com>"
RESEND_API_KEY=

# Compromised-password check against Have I Been Pwned (k-anonymity, fails
# open). hibp (default in production) or off (default elsewhere).
PASSWORD_BREACH_CHECK=off

# Payments (Phase 6). razorpay = the real gateway (required in production),
# fake = in-process gateway for development, tests and CI (refused in production).
PAYMENT_GATEWAY=fake
# Razorpay API keys (Dashboard → Account & Settings → API Keys). Test-mode keys
# start with rzp_test_. Missing keys do not fail the build; online payment is
# simply unavailable until they are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret configured in the Razorpay Dashboard. During rotation keep the
# old one in RAZORPAY_WEBHOOK_SECRET_PREVIOUS until deliveries with it stop.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=

# Bearer secret for the scheduled job routes (/api/cron/*), at least 16 characters.
# Vercel Cron sends it automatically when the variable is named CRON_SECRET.
CRON_SECRET=

# Inbox for new-order notices and operations alerts (optional).
ORDER_NOTIFY_EMAIL=
